# api1.lph
#
#
# Endpoints:
#   GET  /              → 200 "API is running on port 3333 ✈"
#   GET  /health        → 200 JSON { "status": "ok" }
#   GET  /users         → 200 JSON mocked user list
#   GET  /users/1       → 200 JSON specific user (mock)
#   POST /users         → 201 JSON echo of received body
#   PUT  /users/1       → 200 JSON echo of body
#   PATCH /users/1      → 200 JSON echo of body
#   DELETE /users/1     → 204 no body
#   curl http://localhost:3333/
#   curl http://localhost:3333/health
#   curl http://localhost:3333/users
#   curl -X POST http://localhost:3333/users -d '{"name":"Alice"}' -H 'Content-Type: application/json'
#   curl -X PUT  http://localhost:3333/users/1 -d '{"name":"Bob"}'
#   curl -X DELETE http://localhost:3333/users/1

import from "http"
import from "json"


const PORT = 3333
# ── Helpers ───────────────────────────────────────────────────────────────────
# Renamed with "api_" prefix to avoid colliding with symbols already
# exposed by the "http"/"json" modules when imported in full.
fn api_ok_json(body: str) -> void:
    http_respond_json(200, body)
fn api_created_json(body: str) -> void:
    http_respond_json(201, body)
fn api_no_content() -> void:
    http_respond(204, "")
fn api_not_found() -> void:
    http_respond_json(404, "{\"error\": \"not found\"}")
fn api_bad_request(msg: str) -> void:
    http_respond_json(400, "{\"error\": \"" + msg + "\"}")
fn api_method_not_allowed() -> void:
    http_respond_json(405, "{\"error\": \"method not allowed\"}")
# ── Route handlers ────────────────────────────────────────────────────────────
fn handle_root() -> void:
    api_ok_json("{\"message\": \"API is running on port 3333 aviao\"}")
fn handle_health() -> void:
    api_ok_json("{\"status\": \"ok\", \"version\": \"0.1.0\"}")
fn handle_users_list() -> void:
    var body = "["
    body = body + "{\"id\": 1, \"name\": \"Alice\", \"email\": \"alice@example.com\"},"
    body = body + "{\"id\": 2, \"name\": \"Bob\",   \"email\": \"bob@example.com\"},"
    body = body + "{\"id\": 3, \"name\": \"Carol\", \"email\": \"carol@example.com\"}"
    body = body + "]"
    api_ok_json(body)
fn handle_user_get(path: str) -> void:
    # path is like /users/1  — extract the last segment
    var id = replace(path, "/users/", "")
    if id == "1":
        api_ok_json("{\"id\": 1, \"name\": \"Alice\", \"email\": \"alice@example.com\"}")
    elif id == "2":
        api_ok_json("{\"id\": 2, \"name\": \"Bob\", \"email\": \"bob@example.com\"}")
    elif id == "3":
        api_ok_json("{\"id\": 3, \"name\": \"Carol\", \"email\": \"carol@example.com\"}")
    else:
        api_not_found()
fn handle_user_create() -> void:
    var body = http_body()
    if body == "":
        api_bad_request("request body is required")
    else:
        var name = json_get(body, "name")
        if name == "":
            api_bad_request("field 'name' is required")
        else:
            var resp = "{\"id\": 4, \"name\": \"" + name + "\", \"created\": true}"
            api_created_json(resp)
fn handle_user_update(path: str) -> void:
    var body = http_body()
    var id   = replace(path, "/users/", "")
    if body == "":
        api_bad_request("request body is required")
    else:
        var name = json_get(body, "name")
        var resp = "{\"id\": " + id + ", \"name\": \"" + name + "\", \"updated\": true}"
        api_ok_json(resp)
fn handle_user_delete(path: str) -> void:
    var id = replace(path, "/users/", "")
    # 204 No Content — body must be empty
    print("DELETE /users/", id)
    api_no_content()
# ── Router — called once per request ─────────────────────────────────────────
fn route() -> void:
    var method = http_method()
    var path   = http_path()
    print("[", method, "] ", path)
    # GET /
    if method == "GET" and path == "/":
        handle_root()
    # GET /health
    elif method == "GET" and path == "/health":
        handle_health()
    # GET /users
    elif method == "GET" and path == "/users":
        handle_users_list()
    # GET /users/:id
    elif method == "GET" and starts_with(path, "/users/"):
        handle_user_get(path)
    # POST /users
    elif method == "POST" and path == "/users":
        handle_user_create()
    # PUT /users/:id
    elif method == "PUT" and starts_with(path, "/users/"):
        handle_user_update(path)
    # PATCH /users/:id
    elif method == "PATCH" and starts_with(path, "/users/"):
        handle_user_update(path)
    # DELETE /users/:id
    elif method == "DELETE" and starts_with(path, "/users/"):
        handle_user_delete(path)
    # 404 catch-all
    else:
        api_not_found()
# ── Main async loop ───────────────────────────────────────────────────────────
async fn server_loop() -> void:
    while true:
        var got = await http_accept()
        if got:
            route()
# ── Entry point ───────────────────────────────────────────────────────────────
http_listen(PORT)
print("Liphia API running on port ", PORT)
print("Try: curl http://localhost:", PORT, "/")
print("Try: curl http://localhost:", PORT, "/health")
print("Try: curl http://localhost:", PORT, "/users")
spawn server_loop()
